# Copy to deploy/.env on the server and fill in. deploy/.env is never committed.

APP_DOMAIN=selfforge.hexdevop.ru

# Ports on 127.0.0.1 that the host nginx proxies to. Change them if taken on the VPS.
WEB_PORT=8011
API_PORT=8012
MINIO_PORT=8013

# Generate each secret with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_USER=selfforge
POSTGRES_PASSWORD=
POSTGRES_DB=selfforge

# Object storage for progress photos (the MinIO in this stack).
S3_ACCESS_KEY=selfforge
S3_SECRET_KEY=
S3_PHOTOS_BUCKET=progress-photos

# Mail for address confirmation and password reset: any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM="Self Forge <noreply@hexdevop.ru>"

# Backups: database dumps and a mirror of the photos, on this server's disk.
BACKUP_DIR=/var/backups/selfforge
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
