# Used by pytest (see pytest.ini_options.env_files in pyproject.toml).
# Not secret — the test suite runs against an in-memory SQLite DB and a
# fakeredis-backed cache, never these Postgres/Redis values.

ENV=test
DEBUG=false
SECRET_KEY=test-secret-key-not-for-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_test
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
