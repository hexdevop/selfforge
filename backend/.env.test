# Used by pytest (see pytest.ini_options.env_files in pyproject.toml).
# Not secret — local-only values. Tests run against a real Postgres (the `db`
# service from docker-compose, published on 5433; the `app_test` database is
# created automatically) and a fakeredis-backed Redis.

ENV=test
DEBUG=false
SECRET_KEY=test-secret-key-not-for-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_test
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=1
