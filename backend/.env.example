# Copy to `.env` for local (non-docker) development.
# When running via docker-compose, POSTGRES_HOST/REDIS_HOST are overridden
# to the service names (db/redis) by docker-compose.yml — everything else
# here still applies.

PROJECT_NAME="Self Forge"
ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Placeholder only. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with this value when ENV is staging/production.
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Ports below match the docker-compose containers (db/redis published on 5433/6380),
# so `make dev` on the host talks to them. Local-only credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Host port docker-compose publishes Postgres on (not read by the app itself,
# only used to avoid clashing with a Postgres already running on your machine).
POSTGRES_EXPOSED_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
CACHE_DEFAULT_TTL_SECONDS=300
# Same idea as POSTGRES_EXPOSED_PORT, for Redis.
REDIS_EXPOSED_PORT=6380

BACKEND_CORS_ORIGINS=[]

# Links in emails point here.
FRONTEND_URL=http://localhost:5173

# Any SMTP provider. Defaults target the Mailpit container (UI: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM="Self Forge <noreply@selfforge.local>"

# MinIO container credentials (local-only).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Progress photos. The API reaches storage at S3_ENDPOINT_URL; browsers upload and view
# through S3_PUBLIC_URL, which presigned links are signed for.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PHOTOS_BUCKET=progress-photos
